# cp .env.example .env
#
# Two ways to choose which auth-service this console talks to. They are not
# interchangeable — see vite.config.ts.

# ── Local development ────────────────────────────────────────────────────────
# Where `npm run dev` forwards /auth/* . Defaults to a local auth-service on
# :8100 when unset. Point it at a deployed instance to work against real
# accounts without running one locally:
#
#   AUTH_PROXY_TARGET=https://auth-service-<...>.vercel.app
#
# The browser only talks to this dev server, so the hop to the target is
# server-side and the target's CORS allowlist is irrelevant.
AUTH_PROXY_TARGET=

# ── Deployment ───────────────────────────────────────────────────────────────
# Baked into the bundle as an absolute base URL, so the BROWSER calls that host
# directly. Only set this when this console is itself deployed — and then the
# target auth-service must list this app's origin in AUTHSVC_CORS_ORIGINS, or
# every call is blocked by the browser.
#
# Leave empty for local development; the proxy above handles it.
VITE_AUTH_BASE_URL=

# NOTE: whichever you point at, this console administers that instance's REAL
# accounts — create/rename/delete take effect there.
