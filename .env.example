# cp .env.example .env
#
# Which auth-service this console talks to. The app always calls RELATIVE
# paths (/auth/...), and something in front rewrites them to the real service:
#
#   local dev   the Vite dev-server proxy   -> AUTH_PROXY_TARGET below
#   deployed    the Vercel rewrite          -> vercel.json
#
# Both hops are server-side, so the browser is always same-origin and the
# auth-service CORS allowlist never comes into it.

# ── Local development ────────────────────────────────────────────────────────
# Where `npm run dev` forwards /auth/* . Defaults to a local auth-service on
# :8100 when unset. Point it at a deployed instance to work against real
# accounts without running one locally:
#
#   AUTH_PROXY_TARGET=https://auth-service-zhx8.vercel.app
AUTH_PROXY_TARGET=

# ── Escape hatch ─────────────────────────────────────────────────────────────
# Bakes an absolute base URL into the bundle, so the BROWSER calls that host
# directly, bypassing both proxies above. You then MUST add this app's origin
# to the target's AUTHSVC_CORS_ORIGINS — including every Vercel preview URL,
# which change per deployment. Prefer the vercel.json rewrite; only reach for
# this when the console is hosted somewhere that can't rewrite.
VITE_AUTH_BASE_URL=

# NOTE: whichever you point at, this console administers that instance's REAL
# accounts — create/rename/delete take effect there.
