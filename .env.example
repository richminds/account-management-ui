# Base URL of a deployed auth-service instance.
# Leave unset in local dev — the Vite proxy forwards /auth/* to
# http://localhost:8100 (see vite.config.ts).
#
# NOTE: setting this points the app at a REAL deployed service. A local run
# with this set will create/rename/delete accounts in that deployment's
# database, not a sandbox — leave it empty unless that is what you want.
VITE_AUTH_BASE_URL=

# The target auth-service must also set AUTHSVC_CORS_ORIGINS to include this
# app's origin (e.g. http://localhost:5176) — its CORS policy is
# default-closed (service-to-service only).
