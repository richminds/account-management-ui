{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://api-gateway-two-nu.vercel.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api-gateway-two-nu.vercel.app/api/:path*"
    },
    {
      "source": "/((?!auth/|api/|v1/).*)",
      "destination": "/index.html"
    }
  ]
}
